---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/admin/Icon.astro';

const FILTERS = [
  { value: 'all', label: 'All' },
  { value: 'link', label: 'Anyone with the link' },
  { value: 'private', label: 'Only the owner' },
  { value: 'expired', label: 'Expired' },
];
---

<Admin title="Shares" active="shares" description="Every shared session and its owner. Make a share private, or delete it. Admins can open a share that anyone with the link can open; private shares stay closed to them.">
  <div class="toolbar">
    <label class="find">
      <Icon name="search" />
      <span class="sr-only">Search shares by title, owner email, or ID</span>
      <input type="search" placeholder="Search by title, owner, or ID" autocomplete="off" spellcheck="false" data-find />
    </label>
    <div class="filters" role="group" aria-label="Show">
      {FILTERS.map(({ value, label }, index) => (
        <button class="filter" type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-filter={value}>{label}</button>
      ))}
    </div>
  </div>

  <section class="surface" aria-label="Shares">
    <ul class="rows" aria-busy="true" data-list>
      <li class="rows__loading" aria-hidden="true"></li>
    </ul>
    <div class="surface__foot">
      <span data-count></span>
      <button class="btn btn--secondary btn--small" type="button" data-more hidden>Load more</button>
    </div>
  </section>
</Admin>

<script>
  import '../../scripts/admin/shares.ts';
</script>
