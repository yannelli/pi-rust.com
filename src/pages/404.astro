---
import Base from '../layouts/Base.astro';
import Command from '../components/Command.astro';
---

<Base title="Page not found" description="There is no page at this address on pi-rust.com." noindex>
  <section class="missing page">
    <h1>No page here</h1>
    <p>Search the docs, or start from one of these.</p>
    <div class="missing__actions">
      <button class="btn btn--primary" type="button" data-search-open>Search the docs</button>
      <a class="btn btn--secondary" href="/docs/">Docs overview</a>
      <a class="btn btn--secondary" href="/install/">Install</a>
    </div>
    <p class="missing__hint">Looking for the install script?</p>
    <Command command="curl -fsSL https://pi-rust.com/install.sh | sh" label="install command" />
  </section>
</Base>

<style>
  .missing {
    display: grid;
    gap: 16px;
    max-width: 720px;
    padding-block: 96px;
  }

  h1 {
    font-size: clamp(var(--t-32), 5vw, var(--t-48));
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  p {
    color: var(--graphite);
    font-size: var(--t-18);
  }

  .missing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block: 8px 24px;
  }

  .missing__hint {
    font-size: var(--t-14);
  }
</style>
