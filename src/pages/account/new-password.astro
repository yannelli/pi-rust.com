---
import Auth from '../../layouts/Auth.astro';
---

<Auth title="Choose a new password" description="Choose a new password for your pi-rust account.">
  <section data-step="choose">
    <h1>Choose a new password</h1>
    <p class="card__lead">This signs you out everywhere and revokes your CLI tokens.</p>
    <form class="form" method="dialog" novalidate data-password-form>
      <div class="field">
        <label for="password">New password</label>
        <input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="256" aria-describedby="password-hint password-error" required />
        <p class="field__hint" id="password-hint">Use 10 or more characters.</p>
        <p class="field__error" id="password-error" role="alert"></p>
      </div>
      <label class="check"><input type="checkbox" data-show-password /> Show password</label>
      <p class="notice notice--error" role="alert" data-form-error></p>
      <div class="actions actions--end">
        <button class="btn btn--primary" type="submit">Save password</button>
      </div>
    </form>
  </section>

  <section data-step="failed" hidden>
    <h1 data-focus>This link doesn’t work</h1>
    <p class="card__lead">It has expired or was already used. Ask for a new one.</p>
    <div class="actions actions--end">
      <a class="btn btn--primary" href="/account/reset/">Get a new link</a>
    </div>
  </section>
</Auth>

<script>
  import '../../scripts/account/new-password.ts';
</script>
