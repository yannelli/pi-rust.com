---
/** The dialogs the account pages share: confirm it's you (re-authentication) and confirm an action. */
---

<dialog class="dialog" data-reauth aria-labelledby="reauth-title">
  <form class="dialog__form" method="dialog" novalidate data-reauth-form>
    <div class="dialog__body">
      <h2 id="reauth-title">Confirm it’s you</h2>
      <p>Enter your password to continue.</p>
      <div class="field">
        <label for="reauth-password">Password</label>
        <input class="input" id="reauth-password" name="password" type="password" autocomplete="current-password" aria-describedby="reauth-password-error" required />
        <p class="field__error" id="reauth-password-error" role="alert"></p>
      </div>
    </div>
    <div class="dialog__foot">
      <button class="link-button" type="button" data-reauth-passkey hidden>Use a passkey</button>
      <button class="btn btn--secondary" type="button" data-reauth-cancel>Cancel</button>
      <button class="btn btn--primary" type="submit">Confirm</button>
    </div>
  </form>
</dialog>

<dialog class="dialog" data-confirm aria-labelledby="confirm-title" aria-describedby="confirm-text">
  <form method="dialog">
    <div class="dialog__body">
      <h2 id="confirm-title" data-confirm-title></h2>
      <p id="confirm-text" data-confirm-text></p>
    </div>
    <div class="dialog__foot">
      <button class="btn btn--secondary" type="submit" value="cancel" autofocus>Cancel</button>
      <button class="btn btn--danger-solid" type="submit" value="confirm" data-confirm-button></button>
    </div>
  </form>
</dialog>

<dialog class="dialog" data-rename aria-labelledby="rename-title">
  <form method="dialog" novalidate data-rename-form>
    <div class="dialog__body">
      <h2 id="rename-title">Rename passkey</h2>
      <div class="field">
        <label for="rename-name">Name</label>
        <input class="input" id="rename-name" name="name" maxlength="64" autocomplete="off" aria-describedby="rename-name-error" required />
        <p class="field__error" id="rename-name-error" role="alert"></p>
      </div>
    </div>
    <div class="dialog__foot">
      <button class="btn btn--secondary" type="button" data-rename-cancel>Cancel</button>
      <button class="btn btn--primary" type="submit">Save</button>
    </div>
  </form>
</dialog>

<p class="toast" role="status" aria-live="polite" data-toast hidden></p>
