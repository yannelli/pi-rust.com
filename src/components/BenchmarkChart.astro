---
import upstream from '../data/upstream.json';

/** Peak summed memory of 20 concurrent sessions, from the benchmark report. pi-rust's bar is the only one in color. */
const harnesses = upstream.benchmark.harnesses;
const most = Math.max(...harnesses.map((h) => h.peakMiB));
const mib = (value: number) => Math.round(value).toLocaleString('en-US');
---

<figure class="chart">
  <figcaption>Peak memory of 20 concurrent sessions, summed</figcaption>
  <dl>
    {harnesses.map((h, index) => (
      <div class:list={['chart__row', { 'chart__row--ours': index === 0 }]} style={`--w:${(h.peakMiB / most) * 100}%`}>
        <dt>{h.name}</dt>
        <dd>
          <span class="chart__bar" aria-hidden="true" />
          <span class="chart__value">{mib(h.peakMiB)} MiB</span>
        </dd>
      </div>
    ))}
  </dl>
  <p class="chart__foot">Each pi-rust process peaked at {harnesses[0].perProcessMiB} MiB. Batch time: {harnesses.map((h) => `${h.name} ${h.elapsedSeconds} s`).join(', ')}.</p>
</figure>

<style>
  .chart {
    padding: 28px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  figcaption {
    margin-bottom: 22px;
    color: var(--muted);
    font-size: var(--t-13);
  }

  dl {
    display: grid;
    gap: 22px;
  }

  dt {
    color: var(--ink);
    font-size: var(--t-14);
    font-weight: 500;
  }

  dd {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .chart__bar {
    width: var(--w);
    height: 14px;
    border-radius: var(--r-pill);
    background: var(--hairline-strong);
  }

  .chart__row--ours .chart__bar {
    background: var(--rust);
  }

  .chart__value {
    flex: none;
    color: var(--graphite);
    font-size: var(--t-14);
    font-variant-numeric: tabular-nums;
  }

  .chart__row--ours .chart__value {
    color: var(--ink);
    font-weight: 600;
  }

  .chart__foot {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
    color: var(--muted);
    font-size: var(--t-13);
  }
</style>
