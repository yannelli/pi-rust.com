---
import Logo from './Logo.astro';
import { REPO_URL, RELEASE } from '../lib/site';

const NAV = [
  { label: 'Docs', href: '/docs/', match: /^\/docs\// },
  { label: 'Install', href: '/install/', match: /^\/install\// },
  { label: 'Benchmarks', href: '/benchmarks/', match: /^\/benchmarks\// },
  { label: 'Changelog', href: '/changelog/', match: /^\/changelog\// },
  { label: 'FAQ', href: '/faq/', match: /^\/faq\// },
];

const path = Astro.url.pathname;
const stars = RELEASE.stars;
---

<header class="header">
  <div class="header__bar page">
    <a class="header__brand" href="/" aria-label="pi-rust home">
      <Logo />
      <span>pi-rust</span>
    </a>

    <nav class="header__nav" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={item.match.test(path) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header__actions">
      <button class="header__search" type="button" data-search-open aria-haspopup="dialog">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="m21 21-4.3-4.3M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z" /></svg>
        <span class="header__search-label">Search docs</span>
        <kbd>/</kbd>
      </button>
      <a class="btn btn--secondary btn--small header__github" href={REPO_URL} rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.3v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" /></svg>
        <span>GitHub</span>
        <span class="header__stars" aria-label={`${stars} stars`}>{stars}</span>
      </a>
      <details class="header__menu">
        <summary aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 8h16M4 16h16" /></svg>
        </summary>
        <nav class="header__sheet" aria-label="Main menu">
          {NAV.map((item) => (
            <a href={item.href} aria-current={item.match.test(path) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={REPO_URL} rel="noopener">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
    -webkit-backdrop-filter: saturate(1.6) blur(12px);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--header);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--t-16);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    gap: 4px;
  }

  .header__nav a,
  .header__sheet a {
    padding: 6px 10px;
    border-radius: var(--r-pill);
    color: var(--graphite);
    font-size: var(--t-14);
    text-decoration: none;
    transition: color 150ms var(--ease), background-color 150ms var(--ease);
  }

  .header__nav a:hover {
    color: var(--ink);
    background: var(--hover);
  }

  .header__nav a[aria-current='page'],
  .header__sheet a[aria-current='page'] {
    color: var(--ink);
    font-weight: 500;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .header__search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 220px;
    height: 32px;
    padding: 0 6px 0 12px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline-strong);
    color: var(--muted);
    font-size: var(--t-13);
    cursor: pointer;
  }

  .header__search:hover {
    color: var(--graphite);
  }

  .header__search kbd {
    margin-left: auto;
  }

  .header__stars {
    padding-left: 8px;
    border-left: 1px solid var(--hairline-strong);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .header__menu {
    display: none;
    position: relative;
  }

  .header__menu summary {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-pill);
    list-style: none;
    cursor: pointer;
  }

  .header__menu summary::-webkit-details-marker {
    display: none;
  }

  .header__sheet {
    position: absolute;
    right: 0;
    top: 44px;
    display: grid;
    min-width: 200px;
    padding: 8px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.08);
  }

  .header__sheet a {
    padding: 10px 12px;
    border-radius: var(--r-sm);
    font-size: var(--t-16);
  }

  @media (max-width: 980px) {
    .header__search {
      width: 36px;
      padding: 0;
      justify-content: center;
    }

    .header__search-label,
    .header__search kbd {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .header__nav,
    .header__github {
      display: none;
    }

    .header__menu {
      display: block;
    }
  }
</style>
