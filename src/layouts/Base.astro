---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import { AUTHOR, RELEASE, SITE_NAME, SITE_URL } from '../lib/site';
import { abs, person, website } from '../lib/seo';

interface Props {
  /** The page's own title. The <title> appends " | pi-rust" unless `fullTitle` is set. */
  title: string;
  fullTitle?: string;
  description: string;
  /** Social card in public/og/, such as `/og/install.png`. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** JSON-LD nodes for this page; WebSite and Person are always included. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Leaves out the site header, for a page with its own (the session viewer). The footer stays. */
  bare?: boolean;
}

const { title, fullTitle, description, image = '/og/home.png', imageAlt, type = 'website', schema = [], noindex = false, bare = false } = Astro.props;

const documentTitle = fullTitle ?? `${title} | ${SITE_NAME}`;
const canonical = `${SITE_URL}${Astro.url.pathname}`;
const imageUrl = abs(image);
// Feeds show the shared title on its own, so it carries the site name; the home page's title already does.
const shareTitle = fullTitle ?? documentTitle;
const imageText = imageAlt ?? `${title}: ${SITE_NAME}`;
const graph = { '@context': 'https://schema.org', '@graph': [website(), person(), ...schema] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      </>
    )}
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="pi-rust for language models" href="/llms.txt" />
    <link rel="alternate" type="application/atom+xml" title="pi-rust releases" href="https://github.com/yannelli/pi-rust/releases.atom" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageText} />
    {type === 'article' && (
      <>
        <meta property="article:modified_time" content={RELEASE.date} />
        <meta property="article:author" content={AUTHOR.url} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@RyanYannelli" />
    <meta name="twitter:creator" content="@RyanYannelli" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageText} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {!bare && <Header />}
    <main id="main" tabindex="-1" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <Footer />
    <Search />
    <script>
      import '../scripts/copy.ts';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
